12:["$","section",null,{"className":"research-narrative","children":[["$","div",null,{"children":[["$","p",null,{"className":"section-kicker","children":"Unifying question"}],["$","h2",null,{"children":"How can computation expose, and eventually accelerate, the mechanics of complex flow?"}]]}],["$","div",null,{"className":"narrative-copy","children":[["$","p",null,{"children":"My doctoral research used computational fluid dynamics to study transport in dense tumors and anatomical respiratory airways. Current postdoctoral work expands that foundation into bio-inspired fluid–structure interaction, turbulence, and quantum-native multiscale methods."}],["$","p",null,{"children":"Across these systems, the aim is consistent: retain the physics that matter, identify the right computational representation, and develop models that make complex transport more interpretable and tractable."}]]}]]}]
